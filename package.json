{
  "name": "pixsell-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "optimize-images": "mkdir -p scripts && node scripts/optimize-images.js",
    "optimize-images:enhanced": "node scripts/enhanced-image-optimizer.js",
    "optimize-fonts": "mkdir -p scripts && node scripts/optimize-fonts.js",
    "generate-cache": "mkdir -p scripts && node scripts/generate-cache-config.js",
    "optimize-third-party": "mkdir -p scripts && node scripts/optimize-third-party.js",
    "analyze": "ANALYZE=true next build",
    "extract-critical-css": "node scripts/extract-critical-css.js",
    "build:optimized": "npm run build && npm run extract-critical-css",
    "compress": "node scripts/compress-assets.js",
    "minify:enhanced": "node scripts/enhanced-code-minifier.js",
    "optimize:performance": "node scripts/performance-optimizer.js",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "add-hreflang": "node scripts/add-hreflang.js",
    "build:complete": "npm run build && npm run add-hreflang",
    "build:full-optimized": "npm run optimize:performance"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@types/lodash": "^4.17.15",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "framer-motion": "^12.1.0",
    "gsap": "^3.12.7",
    "lodash": "^4.17.21",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^9.5.3",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.0.3",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20.8.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "chalk": "^4.1.2",
    "clean-css": "^5.3.3",
    "critical": "^5.0.4",
    "glob": "^10.4.5",
    "html-minifier": "^4.0.0",
    "image-minimizer-webpack-plugin": "^3.8.3",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.31",
    "purgecss": "^5.0.0",
    "sharp": "^0.33.5",
    "svgo": "^3.1.0",
    "tailwindcss": "^3.3.3",
    "terser": "^5.24.0",
    "typescript": "^5.2.2",
    "workbox-cli": "^7.0.0"
  }
}
